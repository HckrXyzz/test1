    <script>
        // Keep alive script
        function keepAlive() {
            const keepAliveInterval = setInterval(() => {
                if (document.hidden) {
                    console.log("Page is minimized but still running");
                }
            }, 5000);

            return keepAliveInterval;
        }

        const keepAliveInterval = keepAlive();

        // User analytics tracking
        let pageViews = 0;
        let pageEntryTime = new Date();
        let totalTimeOnPage = 0;

        function updateAnalytics() {
            pageViews++;
            document.getElementById('page-views').textContent = pageViews;

            setInterval(() => {
                const currentTime = new Date();
                const timeSpent = Math.floor((currentTime - pageEntryTime) / 1000);
                totalTimeOnPage = timeSpent;

                const hours = Math.floor(timeSpent / 3600);
                const minutes = Math.floor((timeSpent % 3600) / 60);
                const seconds = timeSpent % 60;

                document.getElementById('time-on-page').textContent =
                    `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
            }, 1000);
        }

        updateAnalytics();

        // Header hide on scroll
        let lastScrollTop = 0;
        const header = document.getElementById('header');

        window.addEventListener('scroll', () => {
            const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

            if (scrollTop > lastScrollTop && scrollTop > 100) {
                header.classList.add('hidden');
            } else {
                header.classList.remove('hidden');
            }

            lastScrollTop = scrollTop;
        });

        // Sidebar toggle
        const sidebarToggle = document.getElementById('sidebar-toggle');
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.getElementById('main');

        sidebarToggle.addEventListener('click', () => {
            sidebar.classList.toggle('hidden');

            if (sidebar.classList.contains('hidden')) {
                mainContent.classList.remove('pl-64');
            } else {
                mainContent.classList.add('pl-64');
            }
        });

        // File upload handling
        const dropArea = document.getElementById('drop-area');
        const fileInput = document.getElementById('file-input');
        const fileList = document.getElementById('file-list');

        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropArea.addEventListener(eventName, preventDefaults, false);
        });

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        ['dragenter', 'dragover'].forEach(eventName => {
            dropArea.addEventListener(eventName, highlight, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropArea.addEventListener(eventName, unhighlight, false);
        });

        function highlight() {
            dropArea.classList.add('dragover');
        }

        function unhighlight() {
            dropArea.classList.remove('dragover');
        }

        dropArea.addEventListener('drop', handleDrop, false);
        fileInput.addEventListener('change', handleFiles, false);

        function handleDrop(e) {
            const dt = e.dataTransfer;
            const files = dt.files;
            handleFiles({ target: { files } });
        }

        function handleFiles(e) {
            const files = e.target.files;
            fileList.innerHTML = '';

            Array.from(files).forEach(file => {
                const fileItem = document.createElement('div');
                fileItem.className = 'flex items-center justify-between bg-gray-50 p-2 rounded';

                const fileInfo = document.createElement('div');
                fileInfo.className = 'flex items-center';

                const fileIcon = document.createElement('div');
                fileIcon.className = 'text-blue-500 mr-2';
                fileIcon.innerHTML = `
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                `;

                const fileName = document.createElement('span');
                fileName.className = 'text-sm text-gray-700';
                fileName.textContent = file.name;

                fileInfo.appendChild(fileIcon);
                fileInfo.appendChild(fileName);

                const fileSize = document.createElement('span');
                fileSize.className = 'text-xs';
                fileSize.textContent = formatFileSize(file.size);

                fileItem.appendChild(fileInfo);
                fileItem.appendChild(fileSize);
                fileList.appendChild(fileItem);
            });
        }

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';

            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));

            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        // Working timer and button functionality
        const startButton = document.getElementById('start-button');
        const stopButton = document.getElementById('stop-button');
        const workingOverlay = document.getElementById('working-overlay');
        const countdownElement = document.getElementById('countdown');
        const sessionTimeElement = document.getElementById('session-time');
        const progressBar = document.getElementById('progress-bar');

        let workingTime = 0;
        let workingInterval;
        let totalWorkingTime = 0;
        let isWorking = false;

        function updateWorkingTime() {
            workingTime++;
            totalWorkingTime++;

            const hours = Math.floor(workingTime / 3600);
            const minutes = Math.floor((workingTime % 3600) / 60);
            const seconds = workingTime % 60;

            countdownElement.textContent =
                `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

            sessionTimeElement.textContent =
                `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

            // Update total time
            const totalHours = Math.floor(totalWorkingTime / 3600);
            const totalMinutes = Math.floor((totalWorkingTime % 3600) / 60);
            const totalSeconds = totalWorkingTime % 60;

            document.getElementById('total-time').textContent =
                `${totalHours.toString().padStart(2, '0')}:${totalMinutes.toString().padStart(2, '0')}:${totalSeconds.toString().padStart(2, '0')}`;

            // Update progress bar
            const progress = (workingTime % 100) + 1;
            progressBar.style.width = `${progress}%`;
        }

        startButton.addEventListener('click', () => {
            if (!isWorking) {
                isWorking = true;
                workingOverlay.classList.toggle('hidden');
                startButton.textContent = 'Analysis Running...';
                startButton.classList.remove('pulse');
                startButton.classList.add('bg-gray-500');
                startButton.disabled = true;

                workingInterval = setInterval(updateWorkingTime, 1000);
            }
        });

        stopButton.addEventListener('click', () => {
            if (isWorking) {
                isWorking = false;
                workingOverlay.classList.remove('active');
                startButton.textContent = 'Start Analysis';
                startButton.classList.remove('bg-gray-500');
                startButton.classList.add('pulse');
                startButton.disabled = false;

                clearInterval(workingInterval);
                workingTime = 0;
            }
        });

        // Responsive adjustments for mobile
        function adjustForMobile() {
            if (window.innerWidth < 768) {
                sidebar.classList.add('hidden');
                mainContent.classList.remove('pl-64');
            } else {
                sidebar.classList.remove('hidden');
                mainContent.classList.add('pl-64');
            }
        }

        window.addEventListener('resize', adjustForMobile);
        adjustForMobile();
    </script>
